<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <Include>[HotelBackend]HotelBackend.Models*</Include>
          <Exclude>[HotelBackend]HotelBackend.Controllers.*,[HotelBackend]HotelBackend.Repository.*</Exclude>
          <ExcludeByFile>**/Program.cs,**/obj/**/*.cs,**/Controlers/**/*.cs,**/Repository/**/*.cs</ExcludeByFile>

        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>